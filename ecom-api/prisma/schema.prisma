generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum ProductStatus {
  draft
  published
  archived
}

enum CheckoutStatus {
  OPEN
  PAYMENT_PENDING
  PAYMENT_AUTHORIZED
  COMPLETED
  CANCELED
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLMENT_PENDING
  FULFILLED
  CANCELED
  REFUNDED
}

enum AddressType {
  SHIPPING
  BILLING
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELED
  REFUNDED
}

enum CartStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum CartAdjustmentType {
  DISCOUNT
  SHIPPING
  MANUAL
}

enum InventoryReservationStatus {
  active
  consumed
  released
}

// Ürün ve Varyant Modelleri
model CatalogProduct {
  id          String        @id @default(uuid()) @db.Uuid
  handle      String
  title       String
  subtitle    String?
  description String?
  status      ProductStatus @default(draft)
  publishedAt DateTime?     @db.Timestamptz(6)

  seoTitle       String?
  seoDescription String?
  searchKeywords String?

  rank         Int     @default(0)
  brand        String?
  type         String?
  externalRef  String?
  thumbnailUrl String?

  metadata  Json      @default("{}")
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  variants CatalogProductVariant[]

  @@index([status], map: "idx_catalog_product_status")
  @@index([rank, updatedAt(sort: Desc)], map: "idx_catalog_product_rank_updated")
  @@index([publishedAt(sort: Desc)], map: "idx_catalog_product_published_at")
  @@index([externalRef], map: "idx_catalog_product_external_ref")
  @@index([deletedAt], map: "idx_catalog_product_deleted_at")
  @@map("catalog_product")
}

model CatalogProductVariant {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid

  title   String
  sku     String
  barcode String?
  ean     String?
  upc     String?

  // satış/operasyon flags
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  // inventory davranışı (Inventory modülüne bağlanınca kullanılacak)
  manageInventory Boolean @default(true)
  allowBackorder  Boolean @default(false)

  // ölçü/lojistik (opsiyonel ama kurumsalda çok iş görür)
  weight Int?
  length Int?
  height Int?
  width  Int?

  // entegrasyon
  externalRef String?

  metadata  Json      @default("{}")
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  product CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  priceSets CatalogPriceSet[]

  // kurumsal kalite: aynı product içinde tek default
  inventoryLevels       InventoryLevel[]
  inventoryReservations InventoryReservation[]
  cartLineItems         CartLineItem[]
  orderLineItems        OrderLineItem[]

  @@index([productId], map: "idx_catalog_variant_product")
  @@index([deletedAt], map: "idx_catalog_variant_deleted_at")
  // hızlı lookup
  @@index([sku], map: "idx_catalog_variant_sku")
  @@index([barcode], map: "idx_catalog_variant_barcode")
  @@index([externalRef], map: "idx_catalog_variant_external_ref")
  @@map("catalog_product_variant")
}

model CatalogPriceSet {
  id        String @id @default(uuid()) @db.Uuid
  variantId String @db.Uuid

  // ileride: channelId / regionId / customerGroupId / campaignId eklenebilir
  type     String? // "default", "sale", "b2b" gibi
  isActive Boolean @default(true)

  prices CatalogMoneyAmount[]

  metadata  Json      @default("{}")
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  variant CatalogProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId], map: "idx_price_set_variant")
  @@index([deletedAt], map: "idx_price_set_deleted_at")
  @@map("catalog_price_set")
}

model CatalogMoneyAmount {
  id         String @id @default(uuid()) @db.Uuid
  priceSetId String @db.Uuid

  currencyCode String // "EUR", "TRY"
  amount       Int // minor units: 1999 = 19.99
  compareAt    Int? // optional: üstü çizili fiyat
  minQuantity  Int? // optional: tier pricing başlangıcı
  maxQuantity  Int? // optional: tier pricing bitişi

  isActive Boolean @default(true)

  metadata  Json      @default("{}")
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  priceSet CatalogPriceSet @relation(fields: [priceSetId], references: [id], onDelete: Cascade)

  @@index([priceSetId], map: "idx_money_amount_price_set")
  @@index([currencyCode], map: "idx_money_amount_currency")
  @@index([deletedAt], map: "idx_money_amount_deleted_at")
  @@map("catalog_money_amount")
}

model InventoryLocation {
  id          String  @id @default(uuid()) @db.Uuid
  code        String
  name        String
  address1    String?
  address2    String?
  city        String?
  countryCode String?
  isActive    Boolean @default(true)

  levels       InventoryLevel[]
  reservations InventoryReservation[]

  metadata  Json      @default("{}")
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  @@index([code], map: "idx_inventory_location_code")
  @@index([deletedAt], map: "idx_inventory_location_deleted_at")
  @@map("inventory_location")
}

model InventoryLevel {
  id         String @id @default(uuid()) @db.Uuid
  variantId  String @db.Uuid
  locationId String @db.Uuid

  stocked  Int @default(0)
  reserved Int @default(0)

  isActive Boolean @default(true)

  metadata  Json      @default("{}")
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  variant  CatalogProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location InventoryLocation     @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([variantId], map: "idx_inventory_level_variant")
  @@index([locationId], map: "idx_inventory_level_location")
  @@index([deletedAt], map: "idx_inventory_level_deleted_at")
  @@map("inventory_level")
}

model InventoryReservation {
  id         String @id @default(uuid()) @db.Uuid
  variantId  String @db.Uuid
  locationId String @db.Uuid

  quantity  Int
  status    InventoryReservationStatus @default(active)
  expiresAt DateTime?                  @db.Timestamptz(6)

  referenceType String?
  referenceId   String?

  // yeni audit alanları
  consumedAt     DateTime? @db.Timestamptz(6)
  releasedAt     DateTime? @db.Timestamptz(6)
  consumedByType String?
  consumedById   String?

  metadata  Json      @default("{}")
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  variant  CatalogProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location InventoryLocation     @relation(fields: [locationId], references: [id], onDelete: Cascade)

  lineItemId String?       @db.Uuid
  lineItem   CartLineItem? @relation(fields: [lineItemId], references: [id], onDelete: Cascade)

  @@index([variantId], map: "idx_inventory_res_variant")
  @@index([locationId], map: "idx_inventory_res_location")
  @@index([status], map: "idx_inventory_res_status")
  @@index([expiresAt], map: "idx_inventory_res_expires_at")
  @@index([referenceType, referenceId], map: "idx_inventory_res_reference")
  @@index([deletedAt], map: "idx_inventory_res_deleted_at")
  // yeni index (opsiyonel ama iyi)
  @@index([consumedAt], map: "idx_inventory_res_consumed_at")
  @@index([releasedAt], map: "idx_inventory_res_released_at")
  @@map("inventory_reservation")
}

model Cart {
  id           String     @id @default(uuid()) @db.Uuid
  customerId   String?
  status       CartStatus @default(ACTIVE)
  currencyCode String     @default("EUR")
  regionId     String?
  email        String?
  metadata     Json?
  expiresAt    DateTime?  @db.Timestamptz(6)

  lineItems   CartLineItem[]
  adjustments CartAdjustment[]

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  checkout  Checkout?

  @@index([customerId, status])
  @@index([status, updatedAt])
  @@index([expiresAt])
  @@map("cart")
}

model CartLineItem {
  id        String @id @default(uuid()) @db.Uuid
  cartId    String @db.Uuid
  variantId String @db.Uuid

  skuSnapshot       String?
  titleSnapshot     String?
  quantity          Int
  unitPriceSnapshot Int
  compareAtSnapshot Int?
  metadata          Json?

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  // (opsiyonel ama tavsiye) variant relation
  variant CatalogProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  reservations InventoryReservation[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@index([cartId])
  @@map("cart_line_item")
}

model CartAdjustment {
  id          String             @id @default(uuid()) @db.Uuid
  cartId      String             @db.Uuid
  type        CartAdjustmentType
  code        String?
  description String?
  amount      Int
  metadata    Json?

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([cartId, type])
  @@index([code])
  @@map("cart_adjustment")
}

model Checkout {
  id         String         @id @default(uuid()) @db.Uuid
  cartId     String         @unique @db.Uuid
  customerId String?
  email      String?
  status     CheckoutStatus @default(OPEN)

  currencyCode String  @default("EUR")
  regionId     String?

  // snapshot totals (order'a geçerken birebir taşınır)
  subtotal      Int @default(0)
  discountTotal Int @default(0)
  shippingTotal Int @default(0)
  taxTotal      Int @default(0)
  grandTotal    Int @default(0)

  notes    String?
  metadata Json    @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  cart      Cart              @relation(fields: [cartId], references: [id], onDelete: Cascade)
  addresses CheckoutAddress[]
  payments  OrderPayment[]    @relation("CheckoutPayments")

  @@index([status, updatedAt(sort: Desc)], map: "idx_checkout_status_updated")
  @@index([customerId], map: "idx_checkout_customer")
  @@index([deletedAt], map: "idx_checkout_deleted_at")
  @@map("checkout")
}

model CheckoutAddress {
  id         String      @id @default(uuid()) @db.Uuid
  checkoutId String      @db.Uuid
  type       AddressType

  firstName String?
  lastName  String?
  company   String?
  phone     String?

  address1    String?
  address2    String?
  city        String?
  postalCode  String?
  countryCode String?

  metadata  Json      @default("{}")
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  checkout Checkout @relation(fields: [checkoutId], references: [id], onDelete: Cascade)

  @@unique([checkoutId, type], map: "uniq_checkout_address_type")
  @@index([checkoutId], map: "idx_checkout_address_checkout")
  @@index([deletedAt], map: "idx_checkout_address_deleted_at")
  @@map("checkout_address")
}

model Order {
  id         String  @id @default(uuid()) @db.Uuid
  orderNo    String  @unique // "EC-2025-000001" gibi (app tarafı üretir)
  checkoutId String? @unique @db.Uuid
  cartId     String? @db.Uuid
  customerId String?
  email      String?

  status OrderStatus @default(PENDING)

  currencyCode String  @default("EUR")
  regionId     String?

  subtotal      Int @default(0)
  discountTotal Int @default(0)
  shippingTotal Int @default(0)
  taxTotal      Int @default(0)
  grandTotal    Int @default(0)

  metadata Json @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  lineItems    OrderLineItem[]
  payments     OrderPayment[]       @relation("OrderPayments")
  fulfillments OrderFulfillment[]
  history      OrderStatusHistory[]

  @@index([status, updatedAt(sort: Desc)], map: "idx_order_status_updated")
  @@index([customerId], map: "idx_order_customer")
  @@index([createdAt(sort: Desc)], map: "idx_order_created_at")
  @@map("order")
}

model OrderLineItem {
  id        String @id @default(uuid()) @db.Uuid
  orderId   String @db.Uuid
  variantId String @db.Uuid

  quantity     Int
  unitPrice    Int // snapshot
  compareAt    Int?
  currencyCode String @default("EUR")

  skuSnapshot   String?
  titleSnapshot String?

  metadata  Json      @default("{}")
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  order   Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant CatalogProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId], map: "idx_order_line_item_order")
  @@index([variantId], map: "idx_order_line_item_variant")
  @@map("order_line_item")
}

model OrderPayment {
  id         String  @id @default(uuid()) @db.Uuid
  orderId    String? @db.Uuid
  checkoutId String? @db.Uuid

  provider String // "stripe", "iyzico", "manual"
  status   PaymentStatus @default(PENDING)

  amount       Int
  totalAmount  Int
  currencyCode String @default("EUR")

  externalRef String? // provider intent id
  metadata    Json    @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  order    Order?    @relation("OrderPayments", fields: [orderId], references: [id], onDelete: Cascade)
  checkout Checkout? @relation("CheckoutPayments", fields: [checkoutId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "idx_order_payment_order")
  @@index([checkoutId], map: "idx_order_payment_checkout")
  @@index([provider, externalRef], map: "idx_order_payment_external_ref")
  @@map("order_payment")
}

model OrderFulfillment {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid

  status     String  @default("pending") // ileride enum
  carrier    String?
  trackingNo String?
  metadata   Json    @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "idx_order_fulfillment_order")
  @@map("order_fulfillment")
}

model OrderStatusHistory {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @db.Uuid
  fromStatus String?
  toStatus   String
  note       String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt(sort: Desc)], map: "idx_order_history_order_created")
  @@map("order_status_history")
}
