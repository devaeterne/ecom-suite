generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * =========================
 * ENUMS (mevcut)
 * =========================
 */
enum ProductStatus {
  draft
  published
  archived
}

enum CheckoutStatus {
  OPEN
  PAYMENT_PENDING
  PAYMENT_AUTHORIZED
  COMPLETED
  CANCELED
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLMENT_PENDING
  FULFILLED
  CANCELED
  REFUNDED
}

enum AddressType {
  SHIPPING
  BILLING
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELED
  REFUNDED
}

enum CartStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum CartAdjustmentType {
  DISCOUNT
  SHIPPING
  MANUAL
}

enum InventoryReservationStatus {
  active
  consumed
  released
}

enum MediaType {
  IMAGE
  VIDEO
  FILE
}

enum PriceListType {
  SALE
  B2B
  CAMPAIGN
}

enum AuthProviderType {
  EMAIL_PASSWORD
  GOOGLE
  APPLE
  GITHUB
}

enum RoleScope {
  ADMIN
  STOREFRONT
}

/**
 * =========================
 * 1) PRODUCT / CATALOG (mevcut + eklentiler)
 * =========================
 * Mevcut tabloların: catalog_product, catalog_product_variant, catalog_price_set, catalog_money_amount
 */

model CatalogProduct {
  id          String        @id @default(uuid()) @db.Uuid
  handle      String
  title       String
  subtitle    String?
  description String?
  status      ProductStatus @default(draft)
  publishedAt DateTime?     @db.Timestamptz(6)

  seoTitle       String?
  seoDescription String?
  searchKeywords String?

  rank         Int     @default(0)
  brand        String?
  type         String?
  externalRef  String?
  thumbnailUrl String?

  metadata  Json      @default("{}")
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  variants    CatalogProductVariant[]
  media       ProductMedia[]
  tags        ProductTagLink[]
  categories  ProductCategoryLink[]
  collections ProductCollectionLink[]
  options     ProductOption[]

  @@index([status], map: "idx_catalog_product_status")
  @@index([rank, updatedAt(sort: Desc)], map: "idx_catalog_product_rank_updated")
  @@index([publishedAt(sort: Desc)], map: "idx_catalog_product_published_at")
  @@index([externalRef], map: "idx_catalog_product_external_ref")
  @@index([deletedAt], map: "idx_catalog_product_deleted_at")
  @@map("catalog_product")
}

model CatalogProductVariant {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid

  title   String
  sku     String
  barcode String?
  ean     String?
  upc     String?

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  manageInventory Boolean @default(true)
  allowBackorder  Boolean @default(false)

  weight Int?
  length Int?
  height Int?
  width  Int?

  externalRef String?

  metadata  Json      @default("{}")
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  product CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  priceSets CatalogPriceSet[]

  inventoryLevels       InventoryLevel[]
  inventoryReservations InventoryReservation[]
  cartLineItems         CartLineItem[]
  orderLineItems        OrderLineItem[]

  optionValues       ProductVariantOptionValue[]
  productBundleItems ProductBundleItem[]

  @@index([productId], map: "idx_catalog_variant_product")
  @@index([deletedAt], map: "idx_catalog_variant_deleted_at")
  @@index([sku], map: "idx_catalog_variant_sku")
  @@index([barcode], map: "idx_catalog_variant_barcode")
  @@index([externalRef], map: "idx_catalog_variant_external_ref")
  @@map("catalog_product_variant")
}

/**
 * Product Media (image/video)
 */
model ProductMedia {
  id        String    @id @default(uuid()) @db.Uuid
  productId String    @db.Uuid
  type      MediaType @default(IMAGE)

  url      String
  altText  String?
  rank     Int     @default(0)
  metadata Json    @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  product CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, rank], map: "idx_product_media_product_rank")
  @@index([deletedAt], map: "idx_product_media_deleted_at")
  @@map("product_media")
}

/**
 * Tags
 */
model ProductTag {
  id        String   @id @default(uuid()) @db.Uuid
  value     String   @unique
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  products ProductTagLink[]

  @@map("product_tag")
}

model ProductTagLink {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  tagId     String @db.Uuid

  product CatalogProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     ProductTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([productId, tagId], map: "uniq_product_tag_link")
  @@index([tagId], map: "idx_product_tag_link_tag")
  @@map("product_tag_link")
}

/**
 * Categories (hierarchical)
 */
model ProductCategory {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  handle   String  @unique
  parentId String? @db.Uuid

  rank     Int     @default(0)
  isActive Boolean @default(true)

  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryTree")

  products ProductCategoryLink[]

  @@index([parentId, rank], map: "idx_category_parent_rank")
  @@map("product_category")
}

model ProductCategoryLink {
  id         String @id @default(uuid()) @db.Uuid
  productId  String @db.Uuid
  categoryId String @db.Uuid

  product  CatalogProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId], map: "uniq_product_category_link")
  @@index([categoryId], map: "idx_product_category_link_category")
  @@map("product_category_link")
}

/**
 * Collections
 */
model ProductCollection {
  id       String @id @default(uuid()) @db.Uuid
  title    String
  handle   String @unique
  metadata Json   @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  products ProductCollectionLink[]

  @@map("product_collection")
}

model ProductCollectionLink {
  id           String @id @default(uuid()) @db.Uuid
  productId    String @db.Uuid
  collectionId String @db.Uuid

  product    CatalogProduct    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection ProductCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([productId, collectionId], map: "uniq_product_collection_link")
  @@index([collectionId], map: "idx_product_collection_link_collection")
  @@map("product_collection_link")
}

/**
 * Options
 */
model ProductOption {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid

  title String // e.g. "Size", "Color"
  rank  Int    @default(0)

  product CatalogProduct       @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@index([productId, rank], map: "idx_product_option_product_rank")
  @@map("product_option")
}

model ProductOptionValue {
  id       String @id @default(uuid()) @db.Uuid
  optionId String @db.Uuid

  value String // e.g. "M", "Red"
  rank  Int    @default(0)

  option ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  variants ProductVariantOptionValue[]

  @@unique([optionId, value], map: "uniq_option_value")
  @@index([optionId, rank], map: "idx_product_option_value_option_rank")
  @@map("product_option_value")
}

model ProductVariantOptionValue {
  id            String @id @default(uuid()) @db.Uuid
  variantId     String @db.Uuid
  optionValueId String @db.Uuid

  variant     CatalogProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue    @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@unique([variantId, optionValueId], map: "uniq_variant_option_value")
  @@index([optionValueId], map: "idx_variant_option_value_value")
  @@map("product_variant_option_value")
}

/**
 * Bundle / Kit (optional)
 */
model ProductBundle {
  id       String  @id @default(uuid()) @db.Uuid
  title    String
  handle   String  @unique
  isActive Boolean @default(true)

  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  items ProductBundleItem[]

  @@map("product_bundle")
}

model ProductBundleItem {
  id        String @id @default(uuid()) @db.Uuid
  bundleId  String @db.Uuid
  variantId String @db.Uuid

  quantity Int @default(1)

  bundle  ProductBundle         @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  variant CatalogProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([bundleId, variantId], map: "uniq_bundle_variant")
  @@map("product_bundle_item")
}

/**
 * =========================
 * 2) PRICING (mevcut + ekler)
 * =========================
 */
model CatalogPriceSet {
  id        String @id @default(uuid()) @db.Uuid
  variantId String @db.Uuid

  type     String?
  isActive Boolean @default(true)

  prices CatalogMoneyAmount[]

  metadata  Json      @default("{}")
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  variant CatalogProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId], map: "idx_price_set_variant")
  @@index([deletedAt], map: "idx_price_set_deleted_at")
  @@map("catalog_price_set")
}

model CatalogMoneyAmount {
  id         String @id @default(uuid()) @db.Uuid
  priceSetId String @db.Uuid

  currencyCode String
  amount       Int
  compareAt    Int?
  minQuantity  Int?
  maxQuantity  Int?

  isActive Boolean @default(true)

  metadata  Json      @default("{}")
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  priceSet CatalogPriceSet @relation(fields: [priceSetId], references: [id], onDelete: Cascade)

  @@index([priceSetId], map: "idx_money_amount_price_set")
  @@index([currencyCode], map: "idx_money_amount_currency")
  @@index([deletedAt], map: "idx_money_amount_deleted_at")
  @@map("catalog_money_amount")
}

/**
 * Price Lists + Rules (kampanya/segment/region)
 */
model PriceList {
  id       String        @id @default(uuid()) @db.Uuid
  title    String
  type     PriceListType @default(SALE)
  isActive Boolean       @default(true)

  startsAt DateTime? @db.Timestamptz(6)
  endsAt   DateTime? @db.Timestamptz(6)

  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  rules PriceRule[]

  @@index([isActive, startsAt, endsAt], map: "idx_price_list_active_window")
  @@map("price_list")
}

model PriceRule {
  id          String @id @default(uuid()) @db.Uuid
  priceListId String @db.Uuid

  attribute String // "regionId", "customerGroupId", "channelId"...
  operator  String // "eq", "in", "gte"...
  metadata  Json   @default("{}")

  priceList PriceList        @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  values    PriceRuleValue[]

  @@index([priceListId, attribute], map: "idx_price_rule_list_attr")
  @@map("price_rule")
}

model PriceRuleValue {
  id     String @id @default(uuid()) @db.Uuid
  ruleId String @db.Uuid
  value  String

  rule PriceRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId], map: "idx_price_rule_value_rule")
  @@map("price_rule_value")
}

model Currency {
  code   String  @id // "EUR"
  symbol String?
  name   String?

  @@map("currency")
}

/**
 * =========================
 * 3) INVENTORY (mevcut)
 * =========================
 */
model InventoryLocation {
  id          String  @id @default(uuid()) @db.Uuid
  code        String
  name        String
  address1    String?
  address2    String?
  city        String?
  countryCode String?
  isActive    Boolean @default(true)

  levels       InventoryLevel[]
  reservations InventoryReservation[]

  metadata  Json      @default("{}")
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  @@index([code], map: "idx_inventory_location_code")
  @@index([deletedAt], map: "idx_inventory_location_deleted_at")
  @@map("inventory_location")
}

model InventoryLevel {
  id         String @id @default(uuid()) @db.Uuid
  variantId  String @db.Uuid
  locationId String @db.Uuid

  stocked  Int @default(0)
  reserved Int @default(0)

  isActive Boolean @default(true)

  metadata  Json      @default("{}")
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  variant  CatalogProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location InventoryLocation     @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([variantId], map: "idx_inventory_level_variant")
  @@index([locationId], map: "idx_inventory_level_location")
  @@index([deletedAt], map: "idx_inventory_level_deleted_at")
  @@map("inventory_level")
}

model InventoryReservation {
  id         String @id @default(uuid()) @db.Uuid
  variantId  String @db.Uuid
  locationId String @db.Uuid

  quantity  Int
  status    InventoryReservationStatus @default(active)
  expiresAt DateTime?                  @db.Timestamptz(6)

  referenceType String?
  referenceId   String?

  consumedAt     DateTime? @db.Timestamptz(6)
  releasedAt     DateTime? @db.Timestamptz(6)
  consumedByType String?
  consumedById   String?

  metadata  Json      @default("{}")
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  variant  CatalogProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location InventoryLocation     @relation(fields: [locationId], references: [id], onDelete: Cascade)

  lineItemId String?       @db.Uuid
  lineItem   CartLineItem? @relation(fields: [lineItemId], references: [id], onDelete: Cascade)

  @@index([variantId], map: "idx_inventory_res_variant")
  @@index([locationId], map: "idx_inventory_res_location")
  @@index([status], map: "idx_inventory_res_status")
  @@index([expiresAt], map: "idx_inventory_res_expires_at")
  @@index([referenceType, referenceId], map: "idx_inventory_res_reference")
  @@index([deletedAt], map: "idx_inventory_res_deleted_at")
  @@index([consumedAt], map: "idx_inventory_res_consumed_at")
  @@index([releasedAt], map: "idx_inventory_res_released_at")
  @@map("inventory_reservation")
}

/**
 * =========================
 * 4) CART (mevcut + shipping method eklenecek)
 * =========================
 */
model Cart {
  id           String     @id @default(uuid()) @db.Uuid
  customerId   String?
  status       CartStatus @default(ACTIVE)
  currencyCode String     @default("EUR")
  regionId     String?
  email        String?
  metadata     Json?
  expiresAt    DateTime?  @db.Timestamptz(6)

  lineItems       CartLineItem[]
  adjustments     CartAdjustment[]
  shippingMethods CartShippingMethod[]

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  checkout  Checkout?

  @@index([customerId, status])
  @@index([status, updatedAt])
  @@index([expiresAt])
  @@map("cart")
}

model CartLineItem {
  id        String @id @default(uuid()) @db.Uuid
  cartId    String @db.Uuid
  variantId String @db.Uuid

  skuSnapshot       String?
  titleSnapshot     String?
  quantity          Int
  unitPriceSnapshot Int
  compareAtSnapshot Int?
  metadata          Json?

  cart    Cart                  @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant CatalogProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  reservations InventoryReservation[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@index([cartId])
  @@map("cart_line_item")
}

model CartAdjustment {
  id          String             @id @default(uuid()) @db.Uuid
  cartId      String             @db.Uuid
  type        CartAdjustmentType
  code        String?
  description String?
  amount      Int
  metadata    Json?

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([cartId, type])
  @@index([code])
  @@map("cart_adjustment")
}

model CartShippingMethod {
  id     String @id @default(uuid()) @db.Uuid
  cartId String @db.Uuid

  name         String
  amount       Int
  currencyCode String @default("EUR")
  metadata     Json   @default("{}")

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([cartId], map: "idx_cart_shipping_cart")
  @@map("cart_shipping_method")
}

/**
 * =========================
 * 5) CHECKOUT + ORDER (mevcut + snapshot address/shipping)
 * =========================
 */
model Checkout {
  id         String         @id @default(uuid()) @db.Uuid
  cartId     String         @unique @db.Uuid
  customerId String?
  email      String?
  status     CheckoutStatus @default(OPEN)

  currencyCode String  @default("EUR")
  regionId     String?

  subtotal      Int @default(0)
  discountTotal Int @default(0)
  shippingTotal Int @default(0)
  taxTotal      Int @default(0)
  grandTotal    Int @default(0)

  notes    String?
  metadata Json    @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  cart      Cart              @relation(fields: [cartId], references: [id], onDelete: Cascade)
  addresses CheckoutAddress[]
  payments  OrderPayment[]    @relation("CheckoutPayments")

  @@index([status, updatedAt(sort: Desc)], map: "idx_checkout_status_updated")
  @@index([customerId], map: "idx_checkout_customer")
  @@index([deletedAt], map: "idx_checkout_deleted_at")
  @@map("checkout")
}

model CheckoutAddress {
  id         String      @id @default(uuid()) @db.Uuid
  checkoutId String      @db.Uuid
  type       AddressType

  firstName String?
  lastName  String?
  company   String?
  phone     String?

  address1    String?
  address2    String?
  city        String?
  postalCode  String?
  countryCode String?

  metadata  Json      @default("{}")
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  checkout Checkout @relation(fields: [checkoutId], references: [id], onDelete: Cascade)

  @@unique([checkoutId, type], map: "uniq_checkout_address_type")
  @@index([checkoutId], map: "idx_checkout_address_checkout")
  @@index([deletedAt], map: "idx_checkout_address_deleted_at")
  @@map("checkout_address")
}

model Order {
  id         String  @id @default(uuid()) @db.Uuid
  orderNo    String  @unique
  checkoutId String? @unique @db.Uuid
  cartId     String? @db.Uuid
  customerId String?
  email      String?

  status OrderStatus @default(PENDING)

  currencyCode String  @default("EUR")
  regionId     String?

  subtotal      Int @default(0)
  discountTotal Int @default(0)
  shippingTotal Int @default(0)
  taxTotal      Int @default(0)
  grandTotal    Int @default(0)

  metadata Json @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  lineItems       OrderLineItem[]
  payments        OrderPayment[]        @relation("OrderPayments")
  fulfillments    OrderFulfillment[]
  history         OrderStatusHistory[]
  addresses       OrderAddress[]
  shippingMethods OrderShippingMethod[]

  @@index([status, updatedAt(sort: Desc)], map: "idx_order_status_updated")
  @@index([customerId], map: "idx_order_customer")
  @@index([createdAt(sort: Desc)], map: "idx_order_created_at")
  @@map("order")
}

model OrderAddress {
  id      String      @id @default(uuid()) @db.Uuid
  orderId String      @db.Uuid
  type    AddressType

  firstName String?
  lastName  String?
  company   String?
  phone     String?

  address1    String?
  address2    String?
  city        String?
  postalCode  String?
  countryCode String?

  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, type], map: "uniq_order_address_type")
  @@map("order_address")
}

model OrderShippingMethod {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid

  name         String
  amount       Int
  currencyCode String @default("EUR")
  metadata     Json   @default("{}")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "idx_order_shipping_order")
  @@map("order_shipping_method")
}

model OrderLineItem {
  id        String @id @default(uuid()) @db.Uuid
  orderId   String @db.Uuid
  variantId String @db.Uuid

  quantity     Int
  unitPrice    Int
  compareAt    Int?
  currencyCode String @default("EUR")

  skuSnapshot   String?
  titleSnapshot String?

  metadata  Json      @default("{}")
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  order   Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant CatalogProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId], map: "idx_order_line_item_order")
  @@index([variantId], map: "idx_order_line_item_variant")
  @@map("order_line_item")
}

model OrderPayment {
  id         String  @id @default(uuid()) @db.Uuid
  orderId    String? @db.Uuid
  checkoutId String? @db.Uuid

  provider String
  status   PaymentStatus @default(PENDING)

  amount       Int
  totalAmount  Int
  currencyCode String @default("EUR")

  externalRef String?
  metadata    Json    @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  order    Order?    @relation("OrderPayments", fields: [orderId], references: [id], onDelete: Cascade)
  checkout Checkout? @relation("CheckoutPayments", fields: [checkoutId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "idx_order_payment_order")
  @@index([checkoutId], map: "idx_order_payment_checkout")
  @@index([provider, externalRef], map: "idx_order_payment_external_ref")
  @@map("order_payment")
}

model OrderFulfillment {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid

  status     String  @default("pending")
  carrier    String?
  trackingNo String?
  metadata   Json    @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "idx_order_fulfillment_order")
  @@map("order_fulfillment")
}

model OrderStatusHistory {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @db.Uuid
  fromStatus String?
  toStatus   String
  note       String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt(sort: Desc)], map: "idx_order_history_order_created")
  @@map("order_status_history")
}

/**
 * =========================
 * 9) CUSTOMER (yeni)
 * =========================
 */
model Customer {
  id        String  @id @default(uuid()) @db.Uuid
  email     String  @unique
  firstName String?
  lastName  String?
  phone     String?
  metadata  Json    @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  addresses      CustomerAddress[]
  groups         CustomerGroupCustomerLink[]
  authIdentities AuthIdentity[]

  @@map("customer")
}

model CustomerAddress {
  id         String @id @default(uuid()) @db.Uuid
  customerId String @db.Uuid

  firstName   String?
  lastName    String?
  company     String?
  phone       String?
  address1    String?
  address2    String?
  city        String?
  postalCode  String?
  countryCode String?

  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId], map: "idx_customer_address_customer")
  @@map("customer_address")
}

model CustomerGroup {
  id       String @id @default(uuid()) @db.Uuid
  name     String @unique
  metadata Json   @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  customers CustomerGroupCustomerLink[]

  @@map("customer_group")
}

model CustomerGroupCustomerLink {
  id         String @id @default(uuid()) @db.Uuid
  groupId    String @db.Uuid
  customerId String @db.Uuid

  group    CustomerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([groupId, customerId], map: "uniq_customer_group_customer")
  @@map("customer_group_customer_link")
}

/**
 * =========================
 * 10) ADMIN / USERS + 11) AUTH (yeni)
 * =========================
 */
model User {
  id       String  @id @default(uuid()) @db.Uuid
  email    String  @unique
  name     String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  roles          UserRoleLink[]
  authIdentities AuthIdentity[]

  @@map("user")
}

model Role {
  id    String    @id @default(uuid()) @db.Uuid
  name  String    @unique
  scope RoleScope @default(ADMIN)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  permissions RolePermissionLink[]
  users       UserRoleLink[]

  @@map("role")
}

model Permission {
  id                  String               @id @default(uuid()) @db.Uuid
  key                 String               @unique // "product:write"
  description         String?
  rolePermissionLinks RolePermissionLink[]

  @@map("permission")
}

model RolePermissionLink {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], map: "uniq_role_permission")
  @@map("role_permission_link")
}

model UserRoleLink {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId], map: "uniq_user_role")
  @@map("user_role_link")
}

model AuthIdentity {
  id         String           @id @default(uuid()) @db.Uuid
  provider   AuthProviderType
  providerId String // external id/email hash
  userId     String?          @db.Uuid
  customerId String?          @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([provider, providerId], map: "idx_auth_identity_provider")
  @@map("auth_identity")
}

model Session {
  id         String @id @default(uuid()) @db.Uuid
  identityId String @db.Uuid

  token     String   @unique
  expiresAt DateTime @db.Timestamptz(6)

  identity AuthIdentity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([expiresAt], map: "idx_session_expires")
  @@map("session")
}
