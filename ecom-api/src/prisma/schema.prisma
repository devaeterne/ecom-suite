  tenant   Tenant @relation(fields: [tenantId], references: [id])

  localeCode String

  from String // eski slug
  to   String // yeni slug

  statusCode Int     @default(301) // 301 or 302
  isActive   Boolean @default(true)

  entityType String?
  entityId   String? @db.Uuid

  metadata Json @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  @@unique([tenantId, id])
  @@unique([tenantId, localeCode, from], map: "uniq_redirect_from")
  @@index([tenantId])
  @@index([tenantId, localeCode, isActive], map: "idx_redirect_locale_active")
  @@index([tenantId, entityType, entityId], map: "idx_redirect_entity")
  @@index([tenantId, deletedAt], map: "idx_redirect_tenant_deleted_at")
  @@map("redirect")
}

