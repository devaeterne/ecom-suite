  reuseDetectedAt DateTime? @map("reuse_detected_at") @db.Timestamptz(6) // NEW

  @@index([identityId, revokedAt], map: "idx_session_identity_revoked")
  @@index([expiresAt], map: "idx_session_expires")
  @@index([tenantId])
  @@index([identityId])
  @@index([familyId])
  @@map("session")
}

