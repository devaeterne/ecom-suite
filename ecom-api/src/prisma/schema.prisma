  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  stat ProductDailyStat @relation(fields: [productDailyStatId], references: [id], onDelete: Cascade)

  @@unique([tenantId, day, productDailyStatId, currencyCode], map: "uniq_product_daily_revenue_key")
  @@index([tenantId])
  @@index([tenantId, day], map: "idx_product_daily_revenue_tenant_day")
  @@index([tenantId, currencyCode], map: "idx_product_daily_revenue_tenant_currency")
  @@index([tenantId, deletedAt], map: "idx_product_daily_revenue_tenant_deleted_at")
