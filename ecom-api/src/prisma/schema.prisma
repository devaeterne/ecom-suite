model ProductDailyStat {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  day DateTime @db.Date

  channel    AnalyticsChannel @default(STOREFRONT)
  localeCode String?

  productId String  @db.Uuid
  variantId String? @db.Uuid

  viewCount      Int @default(0)
  addToCartCount Int @default(0)
  purchaseCount  Int @default(0)

  quantitySum Int @default(0) // satın alınan toplam adet
  revenueSum  Int @default(0) // minor units (tek currency varsayımıyla)

  lastEventAt DateTime? @db.Timestamptz(6)

  metadata Json @default("{}")

  createdAt            DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(6)
  deletedAt            DateTime?             @db.Timestamptz(6)
  productDailyRevenues ProductDailyRevenue[]

  @@unique([tenantId, id])
  @@unique([tenantId, day, channel, localeCode, productId, variantId], map: "uniq_product_daily_stat_key")
  @@index([tenantId])
  @@index([tenantId, day], map: "idx_product_daily_stat_tenant_day")
  @@index([tenantId, day, viewCount(sort: Desc)], map: "idx_product_daily_stat_tenant_day_views")
  @@index([tenantId, day, addToCartCount(sort: Desc)], map: "idx_product_daily_stat_tenant_day_atc")
  @@index([tenantId, day, purchaseCount(sort: Desc)], map: "idx_product_daily_stat_tenant_day_purchase")
  @@index([tenantId, day, revenueSum(sort: Desc)], map: "idx_product_daily_stat_tenant_day_revenue")
  @@index([tenantId, productId], map: "idx_product_daily_stat_tenant_product")
  @@index([tenantId, deletedAt], map: "idx_product_daily_stat_tenant_deleted_at")
  @@map("product_daily_stat")
}

model ProductDailyRevenue {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  day DateTime @db.Date

  productDailyStatId String @db.Uuid
  currencyCode       String

  revenueSum Int @default(0)

