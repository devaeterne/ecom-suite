  @@unique([tenantId, id])
  @@index([tenantId, externalRef], map: "idx_order_payment_tenant_external_ref")
  @@index([tenantId])
  @@index([tenantId, provider], map: "idx_order_payment_tenant_provider")
  @@index([tenantId, status], map: "idx_order_payment_tenant_status")
  @@index([tenantId, deletedAt], map: "idx_order_payment_tenant_deleted_at")
  @@map("order_payment")
}

model OrderFulfillment {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // status -> enum (recommended)
  status FulfillmentStatus @default(PENDING)

  // normalize carrier relation (recommended)
  carrierId String?          @db.Uuid
  carrier   ShippingCarrier? @relation(fields: [tenantId, carrierId], references: [tenantId, id], onDelete: Restrict)

  // legacy/quick support: keep if you want (optional)
  // carrier    String?
  trackingNo String?

  metadata Json @default("{}")

  // relations
  items     FulfillmentItem[]
  shipments Shipment[]

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  @@index([orderId], map: "idx_order_fulfillment_order")
  @@index([tenantId])
  @@index([tenantId, orderId], map: "idx_order_fulfillment_tenant_order")
  @@index([carrierId])
  @@map("order_fulfillment")
}

model FulfillmentItem {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

