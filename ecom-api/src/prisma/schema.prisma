  cart   Cart           @relation(fields: [tenantId, cartId], references: [tenantId, id], onDelete: Cascade)
  option ShippingOption @relation(fields: [tenantId, shippingOptionId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, cartId, shippingOptionId], map: "uniq_cart_shipping_method_cart_option")
  @@index([tenantId])
  @@index([tenantId, cartId], map: "idx_cart_shipping_method_tenant_cart")
  @@index([tenantId, deletedAt], map: "idx_cart_shipping_method_tenant_deleted_at")
  @@map("cart_shipping_method")
}

model CartDiscountApplication {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  cartId     String @db.Uuid
  discountId String @db.Uuid

  // kullanıcı hangi kodu girdi? (AUTOMATIC’te null olabilir)
  codeSnapshot String?

  // hesaplama snapshot (audit/debug için)
  methodSnapshot       DiscountMethod
  valueBpSnapshot      Int?
  valueSnapshot        Int?
  currencyCodeSnapshot String?

  // discount bu cart’a ne kadar etki etti? (minor units)
  discountTotal Int @default(0)

  metadata Json @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  cart     Cart     @relation(fields: [tenantId, cartId], references: [tenantId, id], onDelete: Cascade)
  discount Discount @relation(fields: [tenantId, discountId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, cartId, discountId], map: "uniq_cart_discount_application")
  @@index([tenantId])
  @@index([tenantId, cartId], map: "idx_cart_discount_application_tenant_cart")
  @@index([tenantId, discountId], map: "idx_cart_discount_application_tenant_discount")
  @@index([tenantId, deletedAt], map: "idx_cart_discount_application_tenant_deleted_at")
  @@map("cart_discount_application")
}

/**
 * =========================
 * 5) CHECKOUT + ORDER (mevcut + snapshot address/shipping)
 * =========================
 */
model Checkout {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  cartId     String         @db.Uuid
  customerId String?
  email      String?
  status     CheckoutStatus @default(OPEN)

  currencyCode String  @default("EUR")
  regionId     String?

  subtotal      Int @default(0)
  discountTotal Int @default(0)
  shippingTotal Int @default(0)
  taxTotal      Int @default(0)
  grandTotal    Int @default(0)

  notes    String?
  metadata Json    @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  cart                     Cart                      @relation(fields: [tenantId, cartId], references: [tenantId, id], onDelete: Cascade)
  addresses                CheckoutAddress[]
  payments                 OrderPayment[]            @relation("CheckoutPayments")
  inventoryReservations    InventoryReservation[]
  discountRedemptions      DiscountRedemption[]
  bankTransferInstructions BankTransferInstruction[]

  @@unique([tenantId, id])
  @@unique([tenantId, cartId], map: "uniq_checkout_tenant_cart")
  @@index([tenantId])
  @@index([tenantId, deletedAt], map: "idx_checkout_tenant_deleted_at")
  @@index([tenantId, status, updatedAt(sort: Desc)], map: "idx_checkout_tenant_status_updated")
  @@index([tenantId, customerId], map: "idx_checkout_tenant_customer")
  @@map("checkout")
}

model CheckoutAddress {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  checkoutId String @db.Uuid

  type AddressType @default(SHIPPING)

  // kimlik
  fullName String?
  phone    String?
  email    String?

  // adres
  company     String?
  line1       String
  line2       String?
  city        String
  province    String?
  postalCode  String?
  countryIso2 String // "TR", "ME", "RS" ...

  // opsiyonel: Balkanlarda çok iş görür
  taxNo     String?
  taxOffice String?

  metadata Json @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  checkout Checkout @relation(fields: [tenantId, checkoutId], references: [tenantId, id], onDelete: Cascade)
  country  Country  @relation(fields: [countryIso2], references: [iso2], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, checkoutId, type], map: "idx_checkout_address_tenant_checkout_type")
  @@index([countryIso2], map: "idx_checkout_address_country")
  @@index([tenantId, deletedAt], map: "idx_checkout_address_tenant_deleted_at")
  @@map("checkout_address")
}

model Order {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  orderNo    String
  checkoutId String? @db.Uuid
  cartId     String? @db.Uuid
  customerId String?
  email      String?

  status OrderStatus @default(PENDING)

  currencyCode String  @default("EUR")
  regionId     String?

  subtotal      Int @default(0)
  discountTotal Int @default(0)
  shippingTotal Int @default(0)
  taxTotal      Int @default(0)
  grandTotal    Int @default(0)

  metadata Json @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  lineItems                 OrderLineItem[]
  payments                  OrderPayment[]             @relation("OrderPayments")
  fulfillments              OrderFulfillment[]
  history                   OrderStatusHistory[]
  addresses                 OrderAddress[]
  shippingMethods           OrderShippingMethod[]
  paymentCollections        PaymentCollection[]
  inventoryReservations     InventoryReservation[]
  discountRedemptions       DiscountRedemption[]
  orderDiscountApplications OrderDiscountApplication[]
  returnRequests            ReturnRequest[]
  refunds                   Refund[]
  invoices                  Invoice[]
  webhookEvents             WebhookEvent[]
  bankTransferInstructions  BankTransferInstruction[]

  @@unique([tenantId, id])
  @@unique([tenantId, orderNo], map: "uniq_order_tenant_order_no")
  // checkoutId unique olmalı mı?
  // Eğer "1 checkout -> 1 order" şart ise tenant bazlı unique önerilir:
  @@unique([tenantId, checkoutId], map: "uniq_order_tenant_checkout_id")
  @@index([tenantId])
  @@index([tenantId, deletedAt], map: "idx_order_tenant_deleted_at")
  @@index([tenantId, status, updatedAt(sort: Desc)], map: "idx_order_tenant_status_updated")
  @@index([tenantId, customerId], map: "idx_order_tenant_customer")
  @@index([tenantId, createdAt(sort: Desc)], map: "idx_order_tenant_created_at")
  @@map("order")
}

model OrderAddress {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  orderId String @db.Uuid

  type AddressType @default(SHIPPING)

  fullName String?
  phone    String?
  email    String?

  company     String?
  line1       String
  line2       String?
  city        String
  province    String?
  postalCode  String?
  countryIso2 String

  taxNo     String?
  taxOffice String?

  metadata Json @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  order   Order   @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  country Country @relation(fields: [countryIso2], references: [iso2], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, orderId, type], map: "idx_order_address_tenant_order_type")
  @@index([countryIso2], map: "idx_order_address_country")
  @@index([tenantId, deletedAt], map: "idx_order_address_tenant_deleted_at")
  @@map("order_address")
}

model OrderShippingMethod {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  orderId          String  @db.Uuid
  shippingOptionId String? @db.Uuid

  amount       Int
  currencyCode String @default("EUR")

  metadata Json @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  order  Order           @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  option ShippingOption? @relation(fields: [tenantId, shippingOptionId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, orderId], map: "idx_order_shipping_method_tenant_order")
  @@index([tenantId, deletedAt], map: "idx_order_shipping_method_tenant_deleted_at")
  @@map("order_shipping_method")
}

model OrderLineItem {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  orderId   String @db.Uuid
  variantId String @db.Uuid

  quantity     Int
  unitPrice    Int
  compareAt    Int?
  currencyCode String @default("EUR")

  skuSnapshot   String?
  titleSnapshot String?

  metadata  Json      @default("{}")
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
