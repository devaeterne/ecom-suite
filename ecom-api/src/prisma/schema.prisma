model TenantBankAccount {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  isActive  Boolean @default(true)
  isDefault Boolean @default(false)

  type BankTransferType

  bankName      String
  accountHolder String

  iban       String? // SEPA/TR için
  bic        String? // SEPA için
  accountNo  String? // TR için opsiyonel
  branchCode String?
  bankCode   String?

  currencyCode String? // "TRY", "EUR" vb. (boşsa tümü)

  countryIso2 String // "TR", "ME", ...
  address     String? // banka/şube adresi (opsiyonel)

  instructions String? // ödeme açıklaması nasıl yazılacak vs.

  metadata Json @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  country Country @relation(fields: [countryIso2], references: [iso2], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId], map: "idx_tenant_bank_account_tenant")
  @@index([tenantId, isActive, isDefault], map: "idx_tenant_bank_account_default")
  @@index([tenantId, countryIso2, currencyCode], map: "idx_tenant_bank_account_pick")
  @@index([tenantId, deletedAt], map: "idx_tenant_bank_account_tenant_deleted_at")
  @@map("tenant_bank_account")
}

model BankTransferInstruction {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  orderId    String? @db.Uuid
  checkoutId String? @db.Uuid

  bankAccountId String? @db.Uuid // referans (opsiyonel)
  snapshot      Json // iban, bankName, holder, instructions, etc.

  referenceCode String? // müşteri açıklamaya yazsın: "ORDER-2026-0001"
  amount        Int
  currencyCode  String

  status BankTransferStatus @default(PENDING)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  order         Order?         @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  checkout      Checkout?      @relation(fields: [tenantId, checkoutId], references: [tenantId, id], onDelete: Restrict)
  receiptFileId String?        @db.Uuid
  receiptFile   FileObject?    @relation(fields: [tenantId, receiptFileId], references: [tenantId, id], onDelete: Restrict)
  orderPayments OrderPayment[]

  @@unique([tenantId, id])
  @@index([tenantId], map: "idx_bank_transfer_instruction_tenant")
  @@index([tenantId, status, createdAt(sort: Desc)], map: "idx_bank_transfer_instruction_status_time")
  @@index([tenantId, deletedAt], map: "idx_bank_transfer_instruction_tenant_deleted_at")
  @@map("bank_transfer_instruction")
}

model Integration {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  type     IntegrationType
  provider IntegrationProvider
  env      IntegrationEnv      @default(PRODUCTION)

  name   String? // "Stripe Main", "Verifone Balkans"
  status IntegrationStatus @default(DISABLED)

  // non-secret config (örn: webhook url, account id, merchant id)
  config Json @default("{}")

  // runtime flags (örn: "captureMode": "auto", "3ds": true vs.)
  flags Json @default("{}")

  metadata Json @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  secrets          IntegrationSecret[]
  webhooks         IntegrationWebhookEndpoint[]
  integrationRules IntegrationRule[]

  @@unique([tenantId, id])
  @@unique([tenantId, type, provider, env], map: "uniq_integration_tenant_type_provider_env")
  @@index([tenantId])
  @@index([tenantId, status], map: "idx_integration_tenant_status")
  @@index([tenantId, deletedAt], map: "idx_integration_tenant_deleted_at")
  @@map("integration")
}

model IntegrationSecret {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  integrationId String @db.Uuid

  // örn: "apiKey", "webhookSecret", "clientSecret"
  key String

  // encrypted secret veya vault ref
  valueEnc String

  isActive  Boolean   @default(true)
  rotatedAt DateTime? @db.Timestamptz(6)

  metadata Json @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  integration Integration @relation(fields: [tenantId, integrationId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, integrationId, key, isActive], map: "uniq_integration_secret_active_key")
  @@index([tenantId])
  @@index([tenantId, integrationId], map: "idx_integration_secret_integration")
  @@index([tenantId, deletedAt], map: "idx_integration_secret_tenant_deleted_at")
  @@map("integration_secret")
}

model IntegrationWebhookEndpoint {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  integrationId String @db.Uuid

  // sistemin verdiği endpoint (örn: /webhooks/stripe/{tenant}/{id})
  urlPath String

  // provider tarafındaki endpoint id (stripe endpoint id vb.)
  externalRef String?

  status IntegrationStatus @default(ENABLED)

  // dinlenen event listesi (provider’a göre)
  events Json @default("[]") // ["invoice.payment_succeeded", ...]

  // signature verify için hangi secret key kullanılacak?
  secretKeyName String? // "webhookSecret" (IntegrationSecret.key ile eşle)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  integration Integration @relation(fields: [tenantId, integrationId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, integrationId, urlPath], map: "uniq_integration_webhook_path")
  @@index([tenantId])
  @@index([tenantId, integrationId, status], map: "idx_integration_webhook_status")
  @@index([tenantId, deletedAt], map: "idx_integration_webhook_tenant_deleted_at")
  @@map("integration_webhook_endpoint")
}

model IntegrationRule {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  target   IntegrationRuleTarget // PAYMENT/FULFILLMENT
  isActive Boolean               @default(true)

  // hangi integration seçilecek?
  integrationId String      @db.Uuid
  integration   Integration @relation(fields: [tenantId, integrationId], references: [tenantId, id], onDelete: Restrict)

  // Öncelik (küçük sayı daha yüksek öncelik)
  priority Int @default(100)

  // Koşullar (hepsi opsiyonel; boşsa "default" kural gibi davranır)
  countryIso2  String? // "TR", "ME", "DE"
  currencyCode String? // "TRY", "EUR"
  minAmount    Int? // minor unit
  maxAmount    Int?

  // Ödeme tipine göre routing
  paymentMethod String? // "card", "bank_transfer", "cash_on_delivery"
  channelId     String? @db.Uuid // storefront kanalın varsa

  metadata Json @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, target, isActive, priority], map: "idx_integration_rule_pick")
  @@index([tenantId, target, countryIso2, currencyCode], map: "idx_integration_rule_geo_currency")
  @@index([tenantId, deletedAt], map: "idx_integration_rule_tenant_deleted_at")
  @@map("integration_rule")
}

/**
 * =========================
 * 2) BILLING / NOTIFICATIONS / WEBHOOKS
 * =========================
 */
model BillingJobLock {
  id String @id @default(uuid()) @db.Uuid

  key       String   @unique // "billing:daily:2026-01-01" gibi
  lockedAt  DateTime @default(now()) @db.Timestamptz(6)
  expiresAt DateTime @db.Timestamptz(6)

  metadata Json @default("{}")

  @@index([expiresAt], map: "idx_billing_job_lock_expires_at")
  @@map("billing_job_lock")
}

model WebhookEvent {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  provider WebhookProvider

  // Provider’ın event id’si (idempotency anahtarı)
  providerEventId String

  // Provider event type (stripe: "invoice.payment_succeeded" vb.)
  eventType String

  status WebhookEventStatus @default(RECEIVED)

  // raw payload
  payload Json

  // signature verify bilgisi
  signature String?
  verified  Boolean @default(false)

  // retry & error
  attempts    Int       @default(0)
  lastError   String?
  nextRetryAt DateTime? @db.Timestamptz(6)

  // correlation
  requestId String?
  sourceIp  String?
  userAgent String?

  // opsiyonel: bağlanan domain entity’ler
  subscriptionId String? @db.Uuid
  paymentId      String? @db.Uuid
  refundId       String? @db.Uuid
  orderId        String? @db.Uuid

  processedAt DateTime? @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  // Relasyonlar (hepsi opsiyonel; yoksa da event saklanır)
  subscription TenantSubscription?  @relation(fields: [tenantId, subscriptionId], references: [tenantId, id], onDelete: Restrict)
  payment      SubscriptionPayment? @relation(fields: [tenantId, paymentId], references: [tenantId, id], onDelete: Restrict)
  refund       Refund?              @relation(fields: [tenantId, refundId], references: [tenantId, id], onDelete: Restrict)
  order        Order?               @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, provider, providerEventId], map: "uniq_webhook_event_provider_event_id")
  @@index([tenantId])
  @@index([tenantId, provider, status, createdAt(sort: Desc)], map: "idx_webhook_event_provider_status_time")
  @@index([tenantId, status, nextRetryAt], map: "idx_webhook_event_retry_queue")
  @@index([tenantId, deletedAt], map: "idx_webhook_event_tenant_deleted_at")
  @@map("webhook_event")
}

model EmailSchedule {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  type    NotificationType
  channel NotificationChannel @default(EMAIL)

  // hedef
  userId  String? @db.Uuid
  toEmail String
  toName  String?

  // ne zaman?
  sendAt DateTime @db.Timestamptz(6)

  status NotificationStatus @default(PENDING)

  // dedupe anahtarı: aynı olayı 1 kez planla
  dedupeKey String? // örn: "tenant:sub:renewal:2026-01-01"

  // template paramları
  payload Json @default("{}")

  // hata
  attempts  Int     @default(0)
  lastError String?

  sentAt DateTime? @db.Timestamptz(6)

  metadata Json @default("{}")

  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime? @db.Timestamptz(6)
  templateCode String?
  localeCode   String?

  user User? @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)

  logs NotificationLog[]

  @@unique([tenantId, id])
  @@unique([tenantId, dedupeKey], map: "uniq_email_schedule_tenant_dedupe")
  @@index([tenantId])
  @@index([tenantId, status, sendAt], map: "idx_email_schedule_tenant_status_sendat")
  @@index([tenantId, type, sendAt], map: "idx_email_schedule_tenant_type_sendat")
  @@index([tenantId, deletedAt], map: "idx_email_schedule_tenant_deleted_at")
  @@map("email_schedule")
}

model NotificationLog {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  scheduleId String? @db.Uuid

  type    NotificationType
  channel NotificationChannel @default(EMAIL)

  toEmail String
  toName  String?

  status NotificationStatus @default(PROCESSING)

  provider    String? // "ses", "sendgrid", "mailgun", "smtp"
  externalRef String? // provider message id

  payload Json @default("{}")

  errorMessage String?
  sentAt       DateTime? @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  schedule EmailSchedule? @relation(fields: [tenantId, scheduleId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, type, createdAt(sort: Desc)], map: "idx_notification_log_tenant_type_time")
  @@index([tenantId, status, createdAt(sort: Desc)], map: "idx_notification_log_tenant_status_time")
  @@index([tenantId, deletedAt], map: "idx_notification_log_tenant_deleted_at")
  @@map("notification_log")
}

model EmailTemplate {
  id String @id @default(uuid()) @db.Uuid

  code       String // "SUB_RENEWAL_7D", "SUB_SUSPENDED"
  localeCode String // "en", "tr", "sr-Latn"

  subject  String
  bodyHtml String
  bodyText String?

  isActive Boolean @default(true)

  metadata Json @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  @@unique([code, localeCode], map: "uniq_email_template_code_locale")
  @@index([isActive], map: "idx_email_template_active")
  @@index([deletedAt], map: "idx_email_template_deleted_at")
  @@map("email_template")
}

/**
 * =========================
 * 3) REFUNDS / INVOICES
 * =========================
 */
model Refund {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  orderId        String  @db.Uuid
  orderPaymentId String? @db.Uuid // refund hangi payment üzerinden yapıldı?
  returnId       String? @db.Uuid // ReturnRequest ile bağlamak istersen

  status RefundStatus  @default(PENDING)
  reason RefundReason?
  note   String?

  // amount
  amount       Int
  currencyCode String @default("EUR")

  // provider tracking
  provider       String? // "stripe", "verifone", "paypal", "manual"
  externalRef    String? // provider refund id / transaction id
  failureCode    String?
  failureMessage String?

  processedAt DateTime? @db.Timestamptz(6)

  metadata Json @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  order   Order          @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  payment OrderPayment?  @relation(fields: [tenantId, orderPaymentId], references: [tenantId, id], onDelete: Restrict)
  return  ReturnRequest? @relation(fields: [tenantId, returnId], references: [tenantId, id], onDelete: Restrict)

  items               RefundItem[]
  paymentCollection   PaymentCollection? @relation(fields: [paymentCollectionId], references: [id])
  paymentCollectionId String?            @db.Uuid
  invoices            Invoice[]
  webhookEvents       WebhookEvent[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, orderId, createdAt(sort: Desc)], map: "idx_refund_tenant_order_time")
  @@index([tenantId, status, createdAt(sort: Desc)], map: "idx_refund_tenant_status_time")
  @@index([tenantId, provider, externalRef], map: "idx_refund_tenant_provider_ref")
  @@index([tenantId, deletedAt], map: "idx_refund_tenant_deleted_at")
  @@map("refund")
}

model RefundItem {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  refundId        String  @db.Uuid
  orderLineItemId String? @db.Uuid // opsiyonel: shipping/tax refund gibi kalemler için null kalabilir

  amount   Int // bu satırın refund tutarı (minor units)
  quantity Int? // line item refund ise adet

  metadata Json @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  refund   Refund         @relation(fields: [tenantId, refundId], references: [tenantId, id], onDelete: Cascade)
  lineItem OrderLineItem? @relation(fields: [tenantId, orderLineItemId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, refundId], map: "idx_refund_item_tenant_refund")
  @@index([tenantId, orderLineItemId], map: "idx_refund_item_tenant_line_item")
  @@index([tenantId, deletedAt], map: "idx_refund_item_tenant_deleted_at")
  @@map("refund_item")
}

/**
 * =========================
 * 4) INVOICES
 * =========================
 */
model InvoiceSeries {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  code       String // "TR-2026", "EU-2026"
  prefix     String? // "INV-TR-"
  nextNumber Int     @default(1)

  isActive Boolean @default(true)
  metadata Json    @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  invoices Invoice[]

  @@unique([tenantId, id])
  @@unique([tenantId, code], map: "uniq_invoice_series_tenant_code")
  @@index([tenantId])
  @@index([tenantId, isActive], map: "idx_invoice_series_tenant_active")
  @@index([tenantId, deletedAt], map: "idx_invoice_series_tenant_deleted_at")
  @@map("invoice_series")
}

model Invoice {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  type   InvoiceType   @default(SALES)
  status InvoiceStatus @default(DRAFT)

  orderId  String? @db.Uuid
  refundId String? @db.Uuid // credit note refund ile ilişkilendirilebilir
  returnId String? @db.Uuid // opsiyonel

  seriesId  String @db.Uuid
  number    Int
  invoiceNo String // prefix + number gibi, printable

  issuedAt DateTime? @db.Timestamptz(6)
  dueAt    DateTime? @db.Timestamptz(6)

  // currency + totals snapshot
  currencyCode  String @default("EUR")
  subtotal      Int    @default(0)
  discountTotal Int    @default(0)
  shippingTotal Int    @default(0)
  taxTotal      Int    @default(0)
  grandTotal    Int    @default(0)

  // seller snapshot (tenant company)
  sellerName      String
  sellerAddress   Json // address snapshot (line1, city, ...)
  sellerTaxId     String? // TR vergi no
  sellerTaxOffice String? // TR vergi dairesi
  sellerVatId     String? // AB VAT ID

  // buyer snapshot
  buyerName      String
  buyerAddress   Json // address snapshot (line1, city, ...)
  buyerTaxId     String?
  buyerTaxOffice String?
  buyerVatId     String?

  // PDF çıktısı
  pdfFileId String? @db.Uuid

  metadata Json @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  series InvoiceSeries  @relation(fields: [tenantId, seriesId], references: [tenantId, id], onDelete: Restrict)
  order  Order?         @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  refund Refund?        @relation(fields: [tenantId, refundId], references: [tenantId, id], onDelete: Restrict)
  return ReturnRequest? @relation(fields: [tenantId, returnId], references: [tenantId, id], onDelete: Restrict)

  pdfFile FileObject? @relation(fields: [tenantId, pdfFileId], references: [tenantId, id], onDelete: Restrict)

  lines InvoiceLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, seriesId, number], map: "uniq_invoice_series_number")
  @@unique([tenantId, invoiceNo], map: "uniq_invoice_invoice_no")
  @@index([tenantId])
  @@index([tenantId, status, createdAt(sort: Desc)], map: "idx_invoice_tenant_status_time")
  @@index([tenantId, orderId], map: "idx_invoice_tenant_order")
  @@index([tenantId, deletedAt], map: "idx_invoice_tenant_deleted_at")
  @@map("invoice")
}

model InvoiceLine {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  invoiceId String @db.Uuid

  kind InvoiceLineKind @default(ITEM) // ITEM/SHIPPING/DISCOUNT/TAX

  description String
  skuSnapshot String?
  quantity    Int     @default(1)

  unitPrice Int @default(0)
  lineTotal Int @default(0)

  vatRateBp Int? // 2000 = %20
  vatAmount Int? // minor units

  metadata Json @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  invoice Invoice @relation(fields: [tenantId, invoiceId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, invoiceId], map: "idx_invoice_line_tenant_invoice")
  @@index([tenantId, deletedAt], map: "idx_invoice_line_tenant_deleted_at")
  @@map("invoice_line")
}

/**
 * =========================
 * 5) RETURNS / EXCHANGES
 * =========================
 */
model ReturnRequest {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  orderId String @db.Uuid

  status ReturnStatus @default(REQUESTED)

  // müşteri iletişim snapshot
  customerId String? @db.Uuid
  email      String?
  phone      String?

  reason ReturnReason?
  note   String?

  // operasyonel
  receivedAt  DateTime? @db.Timestamptz(6)
  inspectedAt DateTime? @db.Timestamptz(6)
  refundedAt  DateTime? @db.Timestamptz(6)

  // iade label / doküman
  labelFileId String? @db.Uuid // FileObject
  trackingNo  String?
  carrier     String? // "shippo", "easypost", "manual"

  metadata Json @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  order     Order        @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  items     ReturnItem[]
  labelFile FileObject?  @relation(fields: [tenantId, labelFileId], references: [tenantId, id], onDelete: Restrict)

  // Eğer refund entity’n varsa bağlarız; yoksa OrderPayment/PaymentCollection üzerinden yürütürsün
  // refundPaymentId String? @db.Uuid
  refunds  Refund[]
  invoices Invoice[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, orderId], map: "idx_return_request_tenant_order")
  @@index([tenantId, status, createdAt(sort: Desc)], map: "idx_return_request_tenant_status_time")
  @@index([tenantId, deletedAt], map: "idx_return_request_tenant_deleted_at")
  @@map("return_request")
}

model ReturnItem {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  returnId        String @db.Uuid
  orderLineItemId String @db.Uuid

  quantity Int

  reason ReturnReason?
  note   String?

  // depo kontrolü
  receivedQuantity Int     @default(0)
  approvedQuantity Int? // inspection sonrası
  conditionNote    String?

  metadata Json @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  return   ReturnRequest @relation(fields: [tenantId, returnId], references: [tenantId, id], onDelete: Cascade)
  lineItem OrderLineItem @relation(fields: [tenantId, orderLineItemId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, returnId, orderLineItemId], map: "uniq_return_item_line")
  @@index([tenantId])
  @@index([tenantId, returnId], map: "idx_return_item_tenant_return")
  @@index([tenantId, orderLineItemId], map: "idx_return_item_tenant_order_line")
  @@index([tenantId, deletedAt], map: "idx_return_item_tenant_deleted_at")
  @@map("return_item")
}

/**
 * =========================
 * 1) PRODUCT / CATALOG (mevcut + eklentiler)
 * =========================
 * Mevcut tabloların: catalog_product, catalog_product_variant, catalog_price_set, catalog_money_amount
 */

model CatalogProduct {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  handle      String
  title       String
  subtitle    String?
  description String?
  status      ProductStatus @default(draft)
  publishedAt DateTime?     @db.Timestamptz(6)

  seoTitle       String?
  seoDescription String?
  searchKeywords String?

  externalRef String?
  metadata    Json    @default("{}")

  rank      Int       @default(0)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  variants                   CatalogProductVariant[]
  media                      ProductMedia[]
  tags                       ProductTagLink[]
  categories                 ProductCategoryLink[]
  collections                ProductCollectionLink[]
  options                    ProductOption[]
  catalogProductTranslations CatalogProductTranslation[]

  @@unique([tenantId, id])
  @@index([status], map: "idx_catalog_product_status")
  @@index([rank, updatedAt(sort: Desc)], map: "idx_catalog_product_rank_updated")
  @@index([publishedAt(sort: Desc)], map: "idx_catalog_product_published_at")
  @@index([externalRef], map: "idx_catalog_product_external_ref")
  @@index([deletedAt], map: "idx_catalog_product_deleted_at")
  @@index([tenantId])
  @@map("catalog_product")
}

model CatalogProductVariant {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  productId String @db.Uuid

  title   String?
  sku     String?
  barcode String?

  rank     Int     @default(0)
  isActive Boolean @default(true)

  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  product CatalogProduct @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)

  optionValues          ProductVariantOptionValue[]
  bundleItems           ProductBundleItem[]
  catalogPriceSets      CatalogPriceSet[]
  inventoryLevels       InventoryLevel[]
  inventoryReservations InventoryReservation[]
  cartLineItems         CartLineItem[]
  orderLineItems        OrderLineItem[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("catalog_product_variant")
}

/**
 * Product Media (image/video)
 */
model ProductMedia {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  productId String    @db.Uuid
  type      MediaType @default(IMAGE)

  url      String
  altText  String?
  rank     Int     @default(0)
  metadata Json    @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  product CatalogProduct @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, productId, rank], map: "idx_product_media_product_rank")
  @@index([deletedAt], map: "idx_product_media_deleted_at")
  @@index([tenantId])
  @@map("product_media")
}

/**
 * Tags
 */
model ProductTag {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  value    String
  metadata Json   @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  products               ProductTagLink[]
  productTagTranslations ProductTagTranslation[]

  @@unique([tenantId, id])
  @@unique([tenantId, value])
  @@index([tenantId])
  @@map("product_tag")
}

model ProductTagLink {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  productId String @db.Uuid
  tagId     String @db.Uuid

  product CatalogProduct @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)
  tag     ProductTag     @relation(fields: [tenantId, tagId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, productId, tagId], map: "uniq_product_tag_link")
  @@index([tenantId, tagId], map: "idx_product_tag_link_tag")
  @@index([tenantId])
  @@map("product_tag_link")
}

/**
 * Categories (hierarchical)
 */
model ProductCategory {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name     String
  handle   String
  parentId String? @db.Uuid

  rank     Int     @default(0)
  isActive Boolean @default(true)

  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  parent   ProductCategory?  @relation("CategoryTree", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Restrict)
  children ProductCategory[] @relation("CategoryTree")

  products                    ProductCategoryLink[]
  productCategoryTranslations ProductCategoryTranslation[]

  @@unique([tenantId, id])
  @@unique([tenantId, handle])
  @@index([tenantId, parentId, rank], map: "idx_category_parent_rank")
  @@index([tenantId])
  @@map("product_category")
}

model ProductCategoryLink {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  productId  String @db.Uuid
  categoryId String @db.Uuid

  product  CatalogProduct  @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)
  category ProductCategory @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, productId, categoryId], map: "uniq_product_category_link")
  @@index([tenantId, categoryId], map: "idx_product_category_link_category")
  @@index([tenantId])
  @@map("product_category_link")
}

/**
 * Collections
 */
model ProductCollection {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  title    String
  handle   String
  metadata Json   @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  products ProductCollectionLink[]

  @@unique([tenantId, id])
  @@unique([tenantId, handle])
  @@index([tenantId])
  @@map("product_collection")
}

model ProductCollectionLink {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  productId    String @db.Uuid
  collectionId String @db.Uuid

  product    CatalogProduct    @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)
  collection ProductCollection @relation(fields: [tenantId, collectionId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, productId, collectionId], map: "uniq_product_collection_link")
  @@index([tenantId, collectionId], map: "idx_product_collection_link_collection")
  @@index([tenantId])
  @@map("product_collection_link")
}

/**
 * Options
 */
model ProductOption {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  productId String @db.Uuid

  title String // e.g. "Size", "Color"
  rank  Int    @default(0)

  product CatalogProduct       @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([tenantId, id])
  @@index([tenantId, productId, rank], map: "idx_product_option_product_rank")
  @@index([tenantId])
  @@map("product_option")
}

model ProductOptionValue {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  optionId String @db.Uuid

  value String // e.g. "M", "Red"
  rank  Int    @default(0)

  option   ProductOption               @relation(fields: [tenantId, optionId], references: [tenantId, id], onDelete: Cascade)
  variants ProductVariantOptionValue[]

  @@unique([tenantId, id])
  @@unique([tenantId, optionId, value], map: "uniq_option_value")
  @@index([tenantId, optionId, rank], map: "idx_product_option_value_option_rank")
  @@index([tenantId])
  @@map("product_option_value")
}

model ProductVariantOptionValue {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  variantId     String @db.Uuid
  optionValueId String @db.Uuid

  variant     CatalogProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Cascade)
  optionValue ProductOptionValue    @relation(fields: [tenantId, optionValueId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, variantId, optionValueId], map: "uniq_variant_option_value")
  @@index([tenantId, optionValueId], map: "idx_variant_option_value_value")
  @@index([tenantId])
  @@map("product_variant_option_value")
}

/**
 * Bundle / Kit (optional)
 */
model ProductBundle {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  title    String
  handle   String
  isActive Boolean @default(true)

  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  items ProductBundleItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, handle])
  @@index([tenantId])
  @@map("product_bundle")
}

model ProductBundleItem {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  bundleId  String @db.Uuid
  variantId String @db.Uuid

  quantity Int @default(1)

  bundle  ProductBundle         @relation(fields: [tenantId, bundleId], references: [tenantId, id], onDelete: Cascade)
  variant CatalogProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, bundleId, variantId], map: "uniq_bundle_variant")
  @@index([tenantId])
  @@map("product_bundle_item")
}

/**
 * =========================
 * 2) PRICING (mevcut + ekler)
 * =========================
 */
model CatalogPriceSet {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  variantId String @db.Uuid

  type     String?
  isActive Boolean @default(true)

  prices CatalogMoneyAmount[]

  metadata  Json      @default("{}")
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  variant CatalogProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, variantId], map: "idx_price_set_tenant_variant")
  @@index([deletedAt], map: "idx_price_set_deleted_at")
  @@map("catalog_price_set")
}

model CatalogMoneyAmount {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  priceSetId String @db.Uuid

  currencyCode String
  amount       Int
  compareAt    Int?
  minQuantity  Int?
  maxQuantity  Int?

  isActive Boolean @default(true)

  metadata  Json      @default("{}")
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  priceSet CatalogPriceSet @relation(fields: [tenantId, priceSetId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, priceSetId], map: "idx_money_amount_tenant_price_set")
  @@index([currencyCode], map: "idx_money_amount_currency")
  @@index([deletedAt], map: "idx_money_amount_deleted_at")
  @@map("catalog_money_amount")
}

/**
 * Price Lists + Rules (kampanya/segment/region)
 */
model PriceList {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  title    String
  type     PriceListType @default(SALE)
  isActive Boolean       @default(true)

  startsAt DateTime? @db.Timestamptz(6)
  endsAt   DateTime? @db.Timestamptz(6)

  metadata  Json      @default("{}")
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  rules PriceRule[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, isActive, startsAt, endsAt], map: "idx_price_list_tenant_active_window")
  @@index([tenantId, deletedAt], map: "idx_price_list_tenant_deleted_at")
  @@map("price_list")
}

model PriceRule {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  priceListId String @db.Uuid

  attribute String // "regionId", "customerGroupId", "channelId"...
  operator  String // "eq", "in", "gte"...
  metadata  Json   @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  priceList PriceList @relation(fields: [tenantId, priceListId], references: [tenantId, id], onDelete: Cascade)

  values PriceRuleValue[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, priceListId, attribute], map: "idx_price_rule_tenant_list_attr")
  @@index([tenantId, deletedAt], map: "idx_price_rule_tenant_deleted_at")
  @@map("price_rule")
}

model PriceRuleValue {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  ruleId String @db.Uuid
  value  String

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  rule PriceRule @relation(fields: [tenantId, ruleId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, ruleId], map: "idx_price_rule_value_tenant_rule")
  @@index([tenantId, deletedAt], map: "idx_price_rule_value_tenant_deleted_at")
  @@map("price_rule_value")
}

model Currency {
