  orderLineItem   OrderLineItem @relation(fields: [orderLineItemId], references: [id], onDelete: Cascade)

  quantity Int
  metadata Json @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  @@index([tenantId])
  @@index([orderFulfillmentId], map: "idx_fulfillment_item_fulfillment")
  @@index([orderLineItemId], map: "idx_fulfillment_item_line_item")
  @@map("fulfillment_item")
}

model Shipment {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  orderFulfillmentId String           @db.Uuid
  orderFulfillment   OrderFulfillment @relation(fields: [orderFulfillmentId], references: [id], onDelete: Cascade)

  carrierId String          @db.Uuid
  carrier   ShippingCarrier @relation(fields: [carrierId], references: [id], onDelete: Restrict)

  status ShipmentStatus @default(CREATED)

  trackingNumber     String?
  trackingUrl        String?
  labelUrl           String?
  providerShipmentId String?

  shippedAt   DateTime? @db.Timestamptz(6)
  deliveredAt DateTime? @db.Timestamptz(6)

  metadata Json @default("{}")

  events ShipmentTrackingEvent[]

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  @@index([tenantId])
