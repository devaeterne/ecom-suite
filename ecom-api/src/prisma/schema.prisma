}

model SubscriptionPlan {
  id String @id @default(uuid()) @db.Uuid

  code String @unique // "starter", "pro", "enterprise"
  name String

  billingInterval BillingInterval // MONTHLY / YEARLY

  // fiyat (minor units): 9900 = 99.00
  priceAmount  Int
  currencyCode String @default("EUR")

  // feature/limitler
  limits   Json    @default("{}") // { "products": 10000, "users": 10, ... }
  isActive Boolean @default(true)

  metadata Json @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  subscriptions TenantSubscription[]

  @@index([isActive], map: "idx_subscription_plan_active")
  @@index([deletedAt], map: "idx_subscription_plan_deleted_at")
  @@map("subscription_plan")
}

model TenantSubscription {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  planId String           @db.Uuid
  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  status SubscriptionStatus @default(TRIALING)

  // dönem yönetimi
  currentPeriodStart DateTime? @db.Timestamptz(6)
  currentPeriodEnd   DateTime? @db.Timestamptz(6)

  // trial
  trialEndsAt DateTime? @db.Timestamptz(6)

  // iptal davranışı
  cancelAtPeriodEnd Boolean   @default(false)
  canceledAt        DateTime? @db.Timestamptz(6)

  // provider tarafı (Stripe/Verifone vs)
  provider    String? // "stripe", "verifone", "manual"
  externalRef String? // provider subscription id

  metadata Json @default("{}")

  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt   DateTime? @db.Timestamptz(6)
  graceEndsAt DateTime? @db.Timestamptz(6)
  suspendedAt DateTime? @db.Timestamptz(6)

  payments                    SubscriptionPayment[]
  webhookEvents               WebhookEvent[]
  subscriptionLifecycleEvents SubscriptionLifecycleEvent[]

  @@unique([tenantId, id])
  @@unique([tenantId, planId, status, currentPeriodEnd], map: "uniq_tenant_subscription_versioning") // opsiyonel ama işe yarar
  @@index([tenantId], map: "idx_tenant_subscription_tenant")
  @@index([status, currentPeriodEnd], map: "idx_tenant_subscription_status_period_end")
  @@index([deletedAt], map: "idx_tenant_subscription_deleted_at")
  @@index([tenantId, status, currentPeriodEnd], map: "idx_tenant_subscription_tenant_status_period_end")
  @@map("tenant_subscription")
}

model SubscriptionPayment {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  subscriptionId String             @db.Uuid
  subscription   TenantSubscription @relation(fields: [tenantId, subscriptionId], references: [tenantId, id], onDelete: Cascade)

  status SubscriptionPaymentStatus @default(PENDING)

  amount       Int
  currencyCode String @default("EUR")

  provider    String? // "stripe", "verifone", "paypal", "manual"
  externalRef String? // charge/payment_intent/transaction id

  paidAt DateTime? @db.Timestamptz(6)

  // SaaS faturası çıktısı istersen (opsiyonel)
  invoicePdfFileId String?     @db.Uuid
  invoicePdfFile   FileObject? @relation(fields: [tenantId, invoicePdfFileId], references: [tenantId, id], onDelete: Restrict)

  failureCode    String?
  failureMessage String?

  metadata Json @default("{}")

  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(6)
  deletedAt     DateTime?      @db.Timestamptz(6)
  webhookEvents WebhookEvent[]

  @@unique([tenantId, id])
  @@index([tenantId], map: "idx_subscription_payment_tenant")
  @@index([tenantId, subscriptionId, createdAt(sort: Desc)], map: "idx_subscription_payment_sub_time")
  @@index([tenantId, provider, externalRef], map: "idx_subscription_payment_provider_ref")
  @@index([tenantId, status], map: "idx_subscription_payment_status")
  @@index([deletedAt], map: "idx_subscription_payment_deleted_at")
  @@map("subscription_payment")
}

model TenantCompany {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @unique @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // Legal identity
  legalName String
  tradeName String? // marka adı (faturada opsiyonel)
  email     String?
  phone     String?
  website   String?

  // TR fields
  taxId     String? // vergi no / TCKN (B2C için opsiyonel)
  taxOffice String? // vergi dairesi

  // AB fields
  vatId String? // VAT ID

  // Address
  line1       String
  line2       String?
  city        String
  province    String?
  postalCode  String?
  countryIso2 String

  // Branding / docs
  logoFileId String? @db.Uuid // FileObject
  metadata   Json    @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  country  Country     @relation(fields: [countryIso2], references: [iso2], onDelete: Restrict)
  logoFile FileObject? @relation(fields: [tenantId, logoFileId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([countryIso2], map: "idx_tenant_company_country")
  @@index([tenantId, deletedAt], map: "idx_tenant_company_tenant_deleted_at")
  @@map("tenant_company")
}

