}

/**
 * =========================
 * 3) INVENTORY (mevcut)
 * =========================
 */
model InventoryLocation {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name     String
  code     String?
  address  Json? // opsiyonel: street/city/postcode/lat/lng
  metadata Json    @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  levels       InventoryLevel[]
  reservations InventoryReservation[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, deletedAt], map: "idx_inventory_location_tenant_deleted_at")
  @@map("inventory_location")
}

model InventoryLevel {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  locationId String @db.Uuid
  variantId  String @db.Uuid

  stockedQuantity  Int @default(0)
  reservedQuantity Int @default(0)

  metadata Json @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  location InventoryLocation     @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Cascade)
  variant  CatalogProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, locationId, variantId], map: "uniq_inventory_level_location_variant")
  @@index([tenantId])
  @@index([tenantId, variantId], map: "idx_inventory_level_tenant_variant")
  @@index([tenantId, locationId], map: "idx_inventory_level_tenant_location")
  @@index([tenantId, deletedAt], map: "idx_inventory_level_tenant_deleted_at")
  @@map("inventory_level")
}

model InventoryReservation {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  locationId String @db.Uuid
  variantId  String @db.Uuid

  // bağlam
  cartId     String? @db.Uuid
  checkoutId String? @db.Uuid
  orderId    String? @db.Uuid

  // istersen idempotency:
  idempotencyKey String?

  quantity Int

  status InventoryReservationStatus @default(ACTIVE)

  metadata Json @default("{}")

  expiresAt DateTime? @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)

  location InventoryLocation     @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Restrict)
  variant  CatalogProductVariant @relation(fields: [tenantId, variantId], references: [tenantId, id], onDelete: Restrict)

  // Bu relation'lar sende varsa composite'e çevir:
  cart     Cart?     @relation(fields: [tenantId, cartId], references: [tenantId, id], onDelete: Restrict)
  checkout Checkout? @relation(fields: [tenantId, checkoutId], references: [tenantId, id], onDelete: Restrict)
  order    Order?    @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)

  cartLineItem   CartLineItem? @relation(fields: [cartLineItemId], references: [id])
  cartLineItemId String?       @db.Uuid

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, variantId], map: "idx_inventory_reservation_tenant_variant")
  @@index([tenantId, locationId], map: "idx_inventory_reservation_tenant_location")
  @@index([tenantId, status], map: "idx_inventory_reservation_tenant_status")
  @@index([tenantId, expiresAt], map: "idx_inventory_reservation_tenant_expires_at")
  @@index([tenantId, deletedAt], map: "idx_inventory_reservation_tenant_deleted_at")
  @@map("inventory_reservation")
}

/**
 * =========================
 * 4) CART (mevcut + shipping method eklenecek)
 * =========================
 */
model Cart {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
