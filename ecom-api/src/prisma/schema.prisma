  checkout              Checkout?
  inventoryReservations InventoryReservation[]

  createdAt                DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                  @updatedAt @db.Timestamptz(6)
  deletedAt                DateTime?                 @db.Timestamptz(6)
  cartDiscountApplications CartDiscountApplication[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, deletedAt], map: "idx_cart_tenant_deleted_at")
  @@index([tenantId, customerId, status], map: "idx_cart_tenant_customer_status")
  @@index([tenantId, status, updatedAt], map: "idx_cart_tenant_status_updated")
  @@index([tenantId, expiresAt], map: "idx_cart_tenant_expires_at")
  @@map("cart")
}

model CartLineItem {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  cartId    String @db.Uuid
  variantId String @db.Uuid

  skuSnapshot       String?
  titleSnapshot     String?
  quantity          Int
  unitPriceSnapshot Int
  compareAtSnapshot Int?
  metadata          Json?

  cart    Cart                  @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant CatalogProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  reservations InventoryReservation[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@index([cartId])
  @@index([tenantId])
  @@map("cart_line_item")
}

model CartAdjustment {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @db.Uuid
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  cartId      String             @db.Uuid
  type        CartAdjustmentType
  code        String?
  description String?
  amount      Int
  metadata    Json?

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([cartId, type])
  @@index([code])
  @@index([tenantId])
  @@map("cart_adjustment")
}

model CartShippingMethod {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  cartId           String @db.Uuid
  shippingOptionId String @db.Uuid

