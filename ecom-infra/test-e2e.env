# .env.e2e
COMPOSE_PROJECT_NAME=ecom_suite_e2e
API_REPO_PATH=/Users/devaeterne/Projects/ecom-suite/ecom-api

NODE_ENV=test

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ecom_e2e
POSTGRES_USER=ecom
POSTGRES_PASSWORD=ecom_password

DATABASE_URL=postgresql://ecom:ecom_password@127.0.0.1:5432/ecom_e2e?schema=public
SHADOW_DATABASE_URL=postgresql://ecom:ecom_password@127.0.0.1:5432/ecom_e2e_shadow?schema=public

REDIS_HOST=redis
REDIS_PORT=6379

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio_password_123
MINIO_BUCKET=ecom
MINIO_USE_SSL=false

API_PORT=3001

# E2E için cookie’yi “localhost/http” uyumlu yapalım (CI’da rahat)
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
TRUST_PROXY=false

# Extended suite (invite token echo)
INVITE_ECHO_TOKEN=true

STORAGE_ENABLED=false

S3_ENDPOINT=http://127.0.0.1:9000
S3_FORCE_PATH_STYLE=true

