# /ecom-infra/.env
############################
# Global
############################
COMPOSE_PROJECT_NAME=ecom_suite
API_REPO_PATH=/Users/devaeterne/Projects/ecom-suite/ecom-api
ADMIN_REPO_PATH=/Users/devaeterne/Projects/ecom-suite/ecom-admin
STOREFRONT_REPO_PATH=/Users/devaeterne/Projects/ecom-suite/ecom-storefront

NODE_ENV=development

############################
# PostgreSQL
############################
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ecom
POSTGRES_USER=ecom
POSTGRES_PASSWORD=ecom_password

DATABASE_URL=postgresql://ecom:ecom_password@postgres:5432/ecom?schema=public
SHADOW_DATABASE_URL=postgresql://ecom:ecom_password@postgres:5432/ecom_shadow?schema=public


############################
# Redis
############################
REDIS_HOST=redis
REDIS_PORT=6379

############################
# MinIO
############################
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio_password_123
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio_password_123
MINIO_BUCKET=ecom
MINIO_USE_SSL=false

############################
# API
############################
API_PORT=3001

############################
# Prisma
############################
PRISMA_VERSION=7.2.0
PRISMA_STUDIO_PORT=5555

############################
# Admin Panel
############################
ADMIN_PORT=3002
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

############################
# Storefront
############################
STOREFRONT_PORT=3000

############################
# Tenant
############################
TENANT_CONFIG_PATH=/app/config/tenant.json

############################
# JWT and Auth
############################

JWT_ACCESS_SECRET=change_me_long_random
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

COOKIE_DOMAIN=.domain.com
COOKIE_SECURE=true
COOKIE_SECRET=cookie_please_change_me_long_random
TRUST_PROXY=true

ADMIN_ORIGIN=https://admin.domain.com
STORE_ORIGIN=https://domain.com
EXTRA_ORIGINS=

INVITE_SEND_MAIL=false
INVITE_ECHO_TOKEN=true
NODE_ENV=test
