{
  "name": "@ecom/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "pnpm run prisma:generate && tsx watch src/main.ts",
    "dev:docker": "pnpm run dev",
    "build": "nest build",
    "lint": "echo \"(api) lint TBD\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "pnpm -w exec prisma generate --config prisma/prisma.config.ts",
    "prisma:migrate:deploy": "pnpm -w exec prisma migrate deploy --config prisma/prisma.config.ts",
    "prisma:migrate:dev": "pnpm -w exec prisma migrate dev --config prisma/prisma.config.ts"

  },
  "dependencies": {
    "@nestjs/common": "^11.1.10",
    "@nestjs/core": "^11.1.10",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.10",
    "@prisma/client": "7.2.0",
    "@prisma/adapter-pg": "7.2.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "prisma": "7.2.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/node": "^25.0.3",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.16.0",
    "dotenv": "^17.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
