{
  "name": "@ecom/api",
  "version": "0.0.1",
  "private": true,
  "prisma": {
    "schema": "../../prisma/schema.prisma",
    "seed": "ts-node ../../prisma/seed/seed.ts"
  },
  "scripts": {
    "predev": "pnpm run prisma:generate",
    "dev": "tsx watch src/main.ts",
    "dev:docker": "pnpm run dev",
    "build": "nest build",
    "lint": "echo \"(api) lint TBD\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "pnpm exec prisma generate --schema ../../prisma/schema.prisma",
    "prisma:migrate:deploy": "pnpm exec prisma migrate deploy --schema ../../prisma/schema.prisma",
    "prisma:seed": "ts-node ../../prisma/seed/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.10",
    "@nestjs/core": "^11.1.10",
    "@nestjs/platform-express": "^11.1.10",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "bcryptjs": "^3.0.3",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "@prisma/client": "^6.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "dotenv": "^17.2.3",
    "prisma": "^7.2.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
