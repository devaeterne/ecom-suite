{
  "name": "ecom-suite",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "pnpm -r format",
    "db:generate": "pnpm --filter @ecom/api prisma:generate",
    "db:migrate": "pnpm --filter @ecom/api prisma:migrate",
    "db:seed": "pnpm --filter @ecom/api prisma:seed",
    "docker:up": "bash infra/scripts/dev-up.sh",
    "docker:down": "bash infra/scripts/dev-down.sh",
    "docker:resetdb": "bash infra/scripts/db-reset.sh"
  },
  "devDependencies": {
    "dotenv": "^17.2.3",
    "prisma": "^7.2.0",
    "turbo": "^2.1.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.2.0",
    "@prisma/client": "^7.2.0",
    "bcryptjs": "^3.0.3",
    "pg": "^8.16.3"
  }
}