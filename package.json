{
  "name": "ecom-suite",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "pnpm -r format",
    "db:generate": "pnpm exec prisma generate --config prisma/prisma.config.ts",
    "db:migrate:deploy": "pnpm exec prisma migrate deploy --config prisma/prisma.config.ts",
    "db:migrate:dev": "pnpm exec prisma migrate dev --config prisma/prisma.config.ts",
    "db:studio": "pnpm exec prisma studio --config prisma/prisma.config.ts",
    "db:seed": "node prisma/seed/seed.js",
    "seed:build": "tsc -p prisma/seed/tsconfig.json",
    "docker:up": "bash infra/scripts/dev-up.sh",
    "docker:down": "bash infra/scripts/dev-down.sh",
    "docker:resetdb": "bash infra/scripts/db-reset.sh"
  },
  "devDependencies": {
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "prisma": "7.2.0",
    "tsx": "^4.21.0",
    "turbo": "^2.1.3",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "prisma": "7.2.0",
      "@prisma/client": "7.2.0",
      "@prisma/adapter-pg": "7.2.0"
    }
  },
  "dependencies": {
    "@prisma/client": "7.2.0"
  }
}
